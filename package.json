{
  "name": "algorhytme-portfolio",
  "version": "2.0.0",
  "description": "Mohammad Yasrul — Product Builder Portfolio",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/style.css --minify",
    "build:html": "node scripts/build-html.js",
    "build": "npm run build:css && npm run build:html",
    "dev": "tailwindcss -i ./src/input.css -o ./dist/style.css --watch",
    "optimize:images": "node scripts/optimize-images.js"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.33",
    "html-minifier": "^4.0.0",
    "sharp": "^0.33.2"
  }
}